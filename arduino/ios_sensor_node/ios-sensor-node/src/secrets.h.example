#pragma once

// ============================================================
// secrets.h.example — First-Boot Fallback Defaults
// ============================================================
// All settings can now be configured through the web dashboard
// portal (under Settings) and are stored dynamically in ESP32 NVS.
// The constants below are only used as fallback defaults on fresh boots.

// Wi-Fi Station Credentials (fallback if not configured via portal)
const char* WIFI_SSID = "your-router-ssid";
const char* WIFI_PASSWORD = "your-router-password";

// SoftAP Password (at least 8 characters)
const char* AP_PASSWORD = "replace-with-ap-password";

// Device Cloud Token (obtained via Account Binding in dashboard)
const char* AUTH_TOKEN = "replace-with-control-or-device-token";

// Backend Server Configuration
const char* BACKEND_HOST = "192.168.1.33";
const int BACKEND_PORT = 3000;
